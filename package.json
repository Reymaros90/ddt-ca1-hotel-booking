{
  "name": "ddt-ca1-hotel-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal blockchain hotel booking smart contract for academic demonstration",
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node --test tests/*.test.mjs",
